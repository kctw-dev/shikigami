#!/usr/bin/env bash
# session-start — US-317 Phase 2：出勤簽到（checkin）+ scrum-master skill 注入
# US-319：改用 per-session 檔案（YYYY-MM-DD-session-<session_id>.jsonl）消除跨機器 conflict
# AC1：寫入 checkin 紀錄到 docs/attendance/YYYY-MM-DD-session-<session_id>.jsonl
# AC3：紀錄含 session_id, role, event, timestamp, repo
set -euo pipefail

# ---------- Determine plugin root from script location ----------
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# ---------- US-317 Phase 2：出勤簽到（checkin）─────────────────────────────
# 允許 ATTENDANCE_DIR 環境變數覆寫（測試友好設計）
ATTENDANCE_DIR="${ATTENDANCE_DIR:-${PLUGIN_ROOT}/docs/attendance}"
mkdir -p "$ATTENDANCE_DIR"

SESSION_ID="${CLAUDE_SESSION_ID:-unknown}"
# US-319: session_id=unknown 時用 unknown-$(date +%s) 避免覆寫
if [[ "$SESSION_ID" == "unknown" ]]; then
  SESSION_ID="unknown-$(date +%s)"
fi
ROLE="scrum-master"
EVENT="checkin"
TIMESTAMP="$(date '+%Y-%m-%dT%H:%M:%S%z')"
TODAY="$(date '+%Y-%m-%d')"
# US-319: per-session 檔案（YYYY-MM-DD-session-<session_id>.jsonl）
JSONL_FILE="${ATTENDANCE_DIR}/${TODAY}-session-${SESSION_ID}.jsonl"

# 取得 repo 名稱（從 git remote 或目錄名稱）
REPO_ROOT_PATH=$(git rev-parse --show-toplevel 2>/dev/null || echo "$PLUGIN_ROOT")
REPO_NAME=$(git remote get-url origin 2>/dev/null \
  | sed 's|.*[/:]||' | sed 's/\.git$//' \
  || basename "$REPO_ROOT_PATH")

# repo fingerprint 用於 lock 檔案（隔離不同 repo）
REPO_FP=$(echo "$REPO_ROOT_PATH" | sha256sum 2>/dev/null | cut -c1-8 \
         || echo "$REPO_ROOT_PATH" | md5sum 2>/dev/null | cut -c1-8 \
         || echo "fallback0")
ATTENDANCE_LOCK="/tmp/shikigami-attendance-${REPO_FP}.lock"

# US-319: per-session 檔案天然隔離，無需 flock（每個 session 寫自己的檔案）
printf '{"session_id":"%s","role":"%s","event":"%s","timestamp":"%s","repo":"%s"}\n' \
  "$SESSION_ID" "$ROLE" "$EVENT" "$TIMESTAMP" "$REPO_NAME" \
  >> "$JSONL_FILE" 2>/dev/null || true

# ---------- #359：Compact 後自動恢復巡航與 Sprint 進度 ----------
# SESSION_EVENT 由 Claude Code 注入（startup/resume/clear/compact）
RECOVERY_HINTS=""

# 檢查 cruise flag
# 使用已 sanitized 的 SESSION_ID（與 cruise skill 一致）
CRUISE_FLAG="/tmp/shikigami-cruise-${SESSION_ID}.active"
if [[ -f "$CRUISE_FLAG" ]]; then
  RECOVERY_HINTS="${RECOVERY_HINTS}[CRUISE-RECOVER] 偵測到巡航 flag，請恢復 /cruise 巡航。\n"
fi

# 檢查 sprint checkpoint
# 複用已有的 REPO_ROOT_PATH（不重複 git rev-parse）
CHECKPOINT_FILE="${REPO_ROOT_PATH}/docs/sprints/sprint-checkpoint.json"
if [[ -f "$CHECKPOINT_FILE" ]]; then
  SPRINT_NUM=$(grep -o '"sprint": *[0-9]*' "$CHECKPOINT_FILE" 2>/dev/null | grep -o '[0-9]*' || echo "?")
  PENDING=$(grep -c '"pending"' "$CHECKPOINT_FILE" 2>/dev/null || echo "0")
  if [[ "$PENDING" -gt 0 ]]; then
    RECOVERY_HINTS="${RECOVERY_HINTS}[SPRINT-RECOVER] Sprint ${SPRINT_NUM} 進行中，${PENDING} 個 Story 待完成。讀取 ${CHECKPOINT_FILE} 恢復進度。\n"
  fi
fi

# ---------- #443：Compact 後注入 project_level ----------
CONFIG_FILE="${REPO_ROOT_PATH}/.claude/shikigami.local.md"
if [[ -f "$CONFIG_FILE" ]]; then
  PL=$(grep -A5 'shikigami:' "$CONFIG_FILE" | grep 'project_level:' | awk '{print $2}' | head -1)
  RECOVERY_HINTS="${RECOVERY_HINTS}[CONFIG] project_level=${PL:-medium}\n"
fi

# ---------- ADR-033：Trace Log Retention 清理 ----------
# #392：session 啟動時清理超過 retention 天數的 trace log 檔案（靜默不阻塞）
TRACE_RETENTION_SCRIPT="${PLUGIN_ROOT}/hooks/trace-log-retention.sh"
if [[ -f "$TRACE_RETENTION_SCRIPT" ]]; then
  bash "$TRACE_RETENTION_SCRIPT" 2>/dev/null || true
fi

# ---------- ADR-030：OAuth Token Watchdog ----------
# 偵測 Claude OAuth token 是否即將過期，輸出告警（靜默跳過不阻塞）
WATCHDOG_SCRIPT="${PLUGIN_ROOT}/hooks/oauth-token-watchdog.sh"
if [[ -f "$WATCHDOG_SCRIPT" ]]; then
  bash "$WATCHDOG_SCRIPT" || true
fi

# ---------- Read scrum-master skill content ----------
SKILL_FILE="${PLUGIN_ROOT}/skills/scrum-master/SKILL.md"

if [[ ! -f "$SKILL_FILE" ]]; then
  echo '{}'
  exit 0
fi

SKILL_CONTENT="$(cat "$SKILL_FILE")"

# ---------- JSON-escape helper ----------
escape_for_json() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

ESCAPED="$(escape_for_json "$SKILL_CONTENT")"

# ---------- Build the context message ----------
# #359：注入恢復提示（若有）
RECOVERY_PREFIX=""
if [[ -n "$RECOVERY_HINTS" ]]; then
  ESCAPED_HINTS="$(escape_for_json "$(echo -e "$RECOVERY_HINTS")")"
  RECOVERY_PREFIX="\\n\\n## 恢復提示\\n${ESCAPED_HINTS}"
fi

PREFIX="You have shikigami superpowers.${RECOVERY_PREFIX}\\n\\n**Below is the full content of your 'shikigami:scrum-master' skill - your AI Agent Scrum Team controller. For all other skills, use the 'Skill' tool:**"
CONTEXT="<EXTREMELY_IMPORTANT>\\n${PREFIX}\\n\\n${ESCAPED}\\n</EXTREMELY_IMPORTANT>"

# ---------- Output JSON (dual fields for compatibility) ----------
printf '{"additional_context":"%s","hookSpecificOutput":{"additionalContext":"%s"}}' \
  "$CONTEXT" "$CONTEXT"
