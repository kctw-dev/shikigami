.claude/context/
*.pyc
__pycache__/
.venv/
venv/
node_modules/
.env
.env.local
*.swp
.DS_Store
.claude/settings.local.json
.gemini/settings.json
claude-talk-to-figma-mcp/

# VRR 報告長期儲存策略（US-212 / ADR-016 OQ-5）
# 決策：.gitignore 排除 VRR JSON 報告 + 90 天本地保留期限建議
# 理由：VRR JSON 可能內嵌 Base64 截圖導致 repo 持續膨脹；
#       框架現階段（v0.50.x）無雲端基礎設施，外部儲存延後至有實際需求時再引入。
#       目錄結構與 README 仍納入 git（! 規則保留），僅排除報告本體。
docs/vision-critic-reports/*.json

# 系統記錄（live-log, schedule-cruise 等）不入版控
logs/

# Kill Switch runtime files（ADR-038）— flag と report は runtime のみ、git 対象外
.kill-switch/

# cruise logs 歸檔機制（#708 §4.4）
# 歸檔後的原始 JSONL 不入版控，壓縮後的 .gz 保留於 archive 目錄
docs/cruise-logs/archive/**/*.jsonl
# .gz 檔案允許入版控（! 規則豁免）
!docs/cruise-logs/archive/**/*.gz
# Sprint Execution subagent 結果暫存（runtime only，#737 AC NFR1）
docs/sprints/subagent-results/*.md
